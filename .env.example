NEXT_PUBLIC_SUPABASE_URL=https://xbwmhdkshrygehckagdq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhid21oZGtzaHJ5Z2VoY2thZ2RxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM2MzQ0NzksImV4cCI6MjEwOTIxMDQ3OX0.QwjwNwh2lNNtxbBIYqNJtspuj-5Dnpa98L_jqT2GAtA
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments: "alphapay" or "paystack" for GHS only; NGN always uses the OPay
# screenshot upload. "manual" is an instant simulated GHS deposit.
PAYMENT_PROVIDER=alphapay
# AlphaPay — https://app.alphapay.me (sk_test_... keys automatically use sandbox)
# The API key is enough for hosted checkout; no public key is needed.
ALPHAPAY_SECRET_KEY=
# Optional webhook signing secret (shown once in the AlphaPay dashboard).
# If blank, webhooks are re-verified directly against AlphaPay's API.
ALPHAPAY_WEBHOOK_SECRET=
ALPHAPAY_SANDBOX=false
# Paystack — kept for future use
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Not used. NGN always uses the OPay screenshot upload, never a gateway.
PAYSTACK_SECRET_KEY_NGN=
# Manual Naira deposits: the OPay account customers transfer to. The
# screenshot they upload is reviewed by an admin (Naira Account
# Deposits in the admin sidebar) before the wallet is credited.
NAIRA_OPAY_BANK=OPay
NAIRA_OPAY_ACCOUNT_NUMBER=
NAIRA_OPAY_ACCOUNT_NAME=